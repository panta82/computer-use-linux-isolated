# PANTA: persistent private X11/DBus session prevents agent input reaching my desktop.
[Unit]
Description=Computer Use isolated X11 desktop

[Service]
Type=simple
ExecStart=%h/.local/share/computer-use-linux/session.py
Restart=on-failure
RestartSec=2
UMask=0077
KillMode=control-group
TimeoutStopSec=10

[Install]
WantedBy=default.target
